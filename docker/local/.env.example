# =====================================================================
# RallyDeals - Local development environment variables
# =====================================================================
# Copy this file to `docker/local/.env` and fill in real values.
# `.env` is git-ignored (see .gitignore) and is read by docker compose
# (--env-file docker/local/.env) and the scripts in scripts/.
#
# Every value below maps to an env var one or more services read via
# Spring's ${ENV_VAR:default} placeholders (see each repo's application.yml /
# application.properties). Edit values here, not in each service's config.
#
# NOTE: These values are for LOCAL development. DB_HOST values point at the
# local Postgres containers defined in docker/local/docker-compose.yml.
# For production see docker/prod/.env.example (DBs hosted on Aiven).
# =====================================================================

# ---------------------------------------------------------------------
# Shared secrets / credentials (MUST be consistent across services)
# ---------------------------------------------------------------------
# The Auth Service SIGNS RS256 JWTs with the RSA PRIVATE key and all verifiers
# (gateway, services) use the matching RSA PUBLIC key. Same pair everywhere.
# Both auth and the gateway read JWT_PUBLIC_KEY; auth additionally reads
# JWT_PRIVATE_KEY. Use the same naming as rally-gateway.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# rally-common / rally-security (catalog, deal, notification, ...).
# The token needs `read:packages` on the RallyDeals org.
GITHUB_ACTOR=
GITHUB_TOKEN=

# OTP encryption (must match between rally-auth and rally-notification)
OTP_ENCRYPTION_PASSWORD=Rally@OtpKey2026!Sec
OTP_ENCRYPTION_SALT=41b0bf0fbeeb24a5022dc25ead1b5009

# ---------------------------------------------------------------------
# Infrastructure endpoints (used as base URLs / bootstrap)
# ---------------------------------------------------------------------
# Kafka - internal hostname `kafka` / port 9092 for containers on rally-net;
# localhost:9092 for anything on the host.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis - used by the gateway rate limiter.
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------------
# Gateway (:8080)
# ---------------------------------------------------------------------
GATEWAY_PORT=8080
# Downstream URIs - use Docker service names on rally-net.
AUTH_SERVICE_URI=http://auth:8084
CATALOG_SERVICE_URI=http://catalog:8083
DEAL_SERVICE_URI=http://deal:8085
PARTICIPATION_SERVICE_URI=http://participation:8086
INVENTORY_SERVICE_URI=http://inventory:8087
ORDER_SERVICE_URI=http://order:8081
PAYMENT_SERVICE_URI=http://payment:8082
NOTIFICATION_SERVICE_URI=http://notification:8088
OTLP_TRACING_ENDPOINT=http://jaeger:4318/v1/traces
CORS_ORIGIN=http://localhost:4200

# ---------------------------------------------------------------------
# Auth Service (:8084) - DB host is the local `auth-postgres` container
# ---------------------------------------------------------------------
SERVER_PORT=8084
AUTH_DB_HOST=auth-postgres
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USERNAME=user
AUTH_DB_PASSWORD=password
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100
STORAGE_ROOT=./uploads
APP_AUTO_CONFIRM_EMAIL=false
APP_EMAIL_ENABLED=true
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
LOKI_URL=http://loki:3100/loki/api/v1/push
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---------------------------------------------------------------------
# Catalog Service (:8083)
# ---------------------------------------------------------------------
CATALOG_DB_HOST=catalog-postgres
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=postgres
CATALOG_DB_PASSWORD=postgres
DEAL_SERVICE_URL=http://deal:8085

# ---------------------------------------------------------------------
# Deal Service (:8085)
# ---------------------------------------------------------------------
DEAL_DB_HOST=deal-postgres
DEAL_DB_PORT=5432
DEAL_DB_NAME=groupdeal_deals
DEAL_DB_USER=groupdeal
DEAL_DB_PASSWORD=groupdeal
CATALOG_SERVICE_URL=http://catalog:8083
INVENTORY_SERVICE_URL=http://inventory:8087

# ---------------------------------------------------------------------
# Order Service (:8081)
# ---------------------------------------------------------------------
ORDER_DB_URL=jdbc:postgresql://order-postgres:5432/order_db
ORDER_DB_HOST=order-postgres
ORDER_DB_PORT=5432
ORDER_DB_NAME=order_db
ORDER_DB_USERNAME=user
ORDER_DB_PASSWORD=password
ORDER_KAFKA_BOOTSTRAP=kafka:9092

# Order Sweeper & Scheduler
SWEEPER_NORMAL_ORDER_RESERVATION_FIXED_DELAY_MS=2000
SWEEPER_NORMAL_ORDER_RESERVATION_STALE_AFTER=60
SWEEPER_NORMAL_ORDER_RESERVATION_BATCH_SIZE=100
SWEEPER_NORMAL_ORDER_PAYMENT_FIXED_DELAY_MS=2000
SWEEPER_NORMAL_ORDER_PAYMENT_STALE_AFTER=120
SWEEPER_NORMAL_ORDER_PAYMENT_BATCH_SIZE=100
SWEEPER_DEAL_ORDER_PAYMENT_FIXED_DELAY_MS=60000
SWEEPER_DEAL_ORDER_PAYMENT_STALE_AFTER=120
SWEEPER_DEAL_ORDER_PAYMENT_BATCH_SIZE=100
SCHEDULER_SHIPPING_CRON=0 * * * * *
SCHEDULER_SHIPPING_PROCESSING_DURATION_SECONDS=20
SCHEDULER_SHIPPING_SHIPPING_DURATION_SECONDS=30

# ---------------------------------------------------------------------
# Payment Service (:8082) - Stripe keys required
# ---------------------------------------------------------------------
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_WEBHOOK_PATH=/api/v1/payments/webhook
PAYMENT_DB_HOST=payment-postgres
PAYMENT_DB_PORT=5432
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USERNAME=user
PAYMENT_DB_PASSWORD=password
PAYMENT_LOKI_URL=http://loki:3100/loki/api/v1/push
PAYMENT_OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---------------------------------------------------------------------
# Inventory Service (:8087)
# ---------------------------------------------------------------------
INVENTORY_DB_HOST=inventory-postgres
INVENTORY_DB_PORT=5432
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_password

# ---------------------------------------------------------------------
# Participation Service (:8086)
# ---------------------------------------------------------------------
PARTICIPATION_DB_HOST=participation-postgres
PARTICIPATION_DB_PORT=5432
PARTICIPATION_DB_NAME=participation_db
PARTICIPATION_DB_USER=participation
PARTICIPATION_DB_PASSWORD=participation

# ---------------------------------------------------------------------
# Notification Service (:8088) - no DB; reads SMTP via Mailpit inside net
# ---------------------------------------------------------------------
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_FROM=no-reply@rally.local
LOGGING_LEVEL_RALLY=INFO
LOKI_URL=http://loki:3100/loki/api/v1/push
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
